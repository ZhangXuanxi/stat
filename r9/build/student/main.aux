\@writefile{toc}{\contentsline {paragraph}{3. Work out the variation under the null.}{1}{section*.4}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{4. Estimate the null standard error and standardize.}{2}{section*.6}\protected@file@percent }
