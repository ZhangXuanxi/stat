\@writefile{toc}{\contentsline {paragraph}{6. Say what the result means.}{2}{section*.8}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Check the approximation.}{2}{section*.9}\protected@file@percent }
